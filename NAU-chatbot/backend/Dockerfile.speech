FROM pytorch/pytorch:2.9.1-cuda12.8-cudnn9-runtime AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    VIRTUAL_ENV=/opt/venv

RUN python -m venv --system-site-packages "$VIRTUAL_ENV"
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

WORKDIR /build
COPY requirements-common.txt requirements-speech.txt ./
RUN pip install --requirement requirements-speech.txt


FROM pytorch/pytorch:2.9.1-cuda12.8-cudnn9-runtime AS runtime

ENV PATH="/opt/venv/bin:$PATH" \
    HOME=/tmp/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPYCACHEPREFIX=/tmp/pycache \
    HF_HOME=/models/huggingface \
    TOKENIZERS_PARALLELISM=false

RUN apt-get update \
    && apt-get install --no-install-recommends -y ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --home-dir /nonexistent --shell /usr/sbin/nologin app \
    && mkdir -p /models/huggingface \
    && chown -R app:app /models

COPY --from=builder /opt/venv /opt/venv

WORKDIR /opt/app
COPY app ./app
COPY scripts/start-speech.sh ./scripts/start-speech.sh
RUN chmod 0555 scripts/start-speech.sh \
    && chown -R app:app /opt/app

USER app
EXPOSE 8011

HEALTHCHECK --interval=30s --timeout=5s --start-period=20m --retries=5 \
  CMD python -c "import json,urllib.request; data=json.load(urllib.request.urlopen('http://127.0.0.1:8011/health', timeout=3)); assert data.get('ready') is True" || exit 1

CMD ["./scripts/start-speech.sh"]
