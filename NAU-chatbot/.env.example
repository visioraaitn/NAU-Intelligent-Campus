# Copy to .env and replace every REPLACE_* value before starting production.
# Keep the Argon2 hash single-quoted so its dollar signs remain literal.

APP_ENV=production
APP_NAME=IIT Academic Assistant
APP_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PUBLIC_BASE_URL=https://assistant.example.edu

FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
FRONTEND_API_BASE_URL=/api/v1

POSTGRES_DB=iit_academic
POSTGRES_USER=iit
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_POSTGRES_PASSWORD
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# Use a URL-safe Redis password because it is embedded in REDIS_URL by Compose.
REDIS_PASSWORD=REPLACE_WITH_URL_SAFE_REDIS_PASSWORD
SESSION_TTL_SECONDS=86400
SESSION_LOCK_TTL_SECONDS=120
RECENT_HISTORY_LIMIT=24

CHROMA_COLLECTION=iit_academic_v1

INFERENCE_SERVICE_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
INFERENCE_TIMEOUT_SECONDS=120

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$REPLACE_SALT$REPLACE_HASH'
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
SECURE_COOKIES=true

CORS_ORIGINS=https://assistant.example.edu
TRUSTED_HOSTS=assistant.example.edu,localhost,127.0.0.1,backend
MAX_REQUEST_BYTES=32768
CHAT_RATE_LIMIT_PER_MINUTE=20
ADMIN_RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=INFO
LOG_RAW_MESSAGES=false
WEB_CONCURRENCY=2
FORWARDED_ALLOW_IPS=*

RAG_QUEUE_KEY=iit:rag:jobs
RAG_PROCESSING_KEY=iit:rag:processing
RAG_DEAD_LETTER_KEY=iit:rag:dead
RAG_MAX_ATTEMPTS=5
RAG_RETRY_BASE_SECONDS=2
RAG_STATUS_TTL_SECONDS=604800

# Leave paths empty when the complete Hugging Face cache is staged in model_data.
# Otherwise use absolute container paths below /models/huggingface.
ESPRIT_MODEL_ID=
ESPRIT_MODEL_PATH=
QWEN_MODEL_ID=
QWEN_MODEL_PATH=
EMBED_MODEL_ID=
EMBED_MODEL_PATH=
RERANK_MODEL_ID=
RERANK_MODEL_PATH=
MODELS_LOCAL_ONLY=true
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
NVIDIA_VISIBLE_DEVICES=all
